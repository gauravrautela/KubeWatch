# KubeWatch hub — central backend (ingest API + ClickHouse writer).
# Build context: repository root.  Build: docker build -f Dockerfile.hub -t kubewatch-hub .
# --platform=$BUILDPLATFORM: the builder runs on the host's native arch (fast),
# and Go cross-compiles to the TARGET arch below.
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# TARGETOS/TARGETARCH are supplied by BuildKit from --platform (e.g. linux/amd64).
# Defaults make a plain `docker build` also produce a linux/amd64 binary.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
      -ldflags="-s -w -X github.com/gauravrautela/kubewatch/internal/version.Version=${VERSION}" \
      -o /out/kubewatch-hub ./cmd/hub

# Static, non-root runtime (UID 65532).
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/kubewatch-hub /kubewatch-hub
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/kubewatch-hub"]
